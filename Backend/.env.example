# Application
NODE_ENV=development
PORT=3000
SESSION_SECRET=change-me-use-at-least-32-random-characters
SESSION_COOKIE_NAME=web.sid
SESSION_TTL_MS=28800000
# Keep this above Nginx upstream keepalive_timeout (currently 60s).
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000
ENABLE_EMAIL_SCHEDULER=false
# EMAIL_SCHEDULER_CRON=0 9 * * *
# EMAIL_SCHEDULER_TO=notifications@example.com
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# MongoDB (docker-compose.yml)
DATABASE_URL=mongodb://root:123456@localhost:27017/english_learning?authSource=admin&replicaSet=rs0&directConnection=true

# Redis (docker-compose.yml)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_COMMAND_TIMEOUT_MS=3000
REDIS_CONNECT_TIMEOUT_MS=5000
# Short-lived, bounded in-process L1 cache (Redis remains the shared L2).
L1_CACHE_TTL_MS=5000
L1_CACHE_MAX_ENTRIES=1000
L1_CACHE_MAX_BYTES=33554432
# Distributed cache-fill lock used to prevent cross-instance stampedes.
CACHE_LOCK_TTL_MS=10000
CACHE_LOCK_WAIT_MS=10500
RATE_LIMIT_REDIS_TIMEOUT_MS=100
# One positive-only L1 shared by authentication and rate-limit identity lookup.
JWT_L1_CACHE_TTL_MS=60000
JWT_L1_CACHE_MAX_ENTRIES=10000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_MS=60000
HEAVY_RATE_LIMIT_MAX_REQUESTS=10
HEAVY_RATE_LIMIT_WINDOW_MS=60000
# Cross-instance lock protecting Redis study-session read/modify/write cycles.
STUDY_SESSION_LOCK_TTL_MS=10000
STUDY_SESSION_LOCK_WAIT_MS=11000

# Reverse proxy trust boundary. Keep false when clients connect directly.
# Prefer explicit proxy IPs/CIDRs (comma-separated). A hop count is safe only
# when the backend cannot be reached except through that fixed proxy chain.
TRUST_PROXY=false

# JWT
JWT_SECRET=change-me-access-secret
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRE=7d

# Optional services
WEBSOCKET_PORT=8000
RABBIT_HOST=127.0.0.1
RABBIT_PORT=5672
RABBIT_USERNAME=guest
RABBIT_PASSWORD=guest
