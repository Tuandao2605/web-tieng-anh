model User {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    name      String?
    email     String   @unique
    password  String?
    status    Boolean  @default(true)
    createdAt DateTime @default(now()) @db.Timestamp()
    updatedAt DateTime @updatedAt @db.Timestamp()
    phone     Phone?
    post      Post[]

    @@map("users")
}
